{
  "$schema": "urn:dsh-std:community-draft:dsh-plugin:0.15",
  "manifestVersion": "0.15",
  "id": "dsh-deepseek-cost",
  "name": "dsh-deepseek-cost",
  "version": "0.5.1",
  "license": "MIT",
  "facets": {
    "host": {
      "entry": "lib/types/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "storage.dsh/v1alpha1",
        "kind": "LocalStorage"
      }
    ]
